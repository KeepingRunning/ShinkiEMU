# Mobile toolchains must use target libraries, even if the host has FFmpeg installed.
add_library(leaf_mobile_codecs INTERFACE)
set(leaf_media_libs "")
foreach(component avformat avcodec swscale swresample avutil)
    set(archive "${LEAF_MEDIA_PREFIX}/lib/lib${component}.a")
    if(NOT EXISTS "${archive}")
        message(FATAL_ERROR "Missing target codec archive: ${archive}")
    endif()
    list(APPEND leaf_media_libs "${archive}")
endforeach()
target_include_directories(leaf_mobile_codecs INTERFACE "${LEAF_MEDIA_PREFIX}/include")
target_link_libraries(leaf_mobile_codecs INTERFACE ${leaf_media_libs} m)
if(ANDROID)
    target_link_libraries(leaf_mobile_codecs INTERFACE log android)
endif()
