set(LEAF_MOBILE_DIR "${CMAKE_CURRENT_LIST_DIR}")
if(ANDROID)
    add_library(leaf_player SHARED "${LEAF_MOBILE_DIR}/player.cpp")
    set_target_properties(leaf_player PROPERTIES OUTPUT_NAME main)
    target_link_libraries(leaf_player PRIVATE wa2_trial SDL2)
    target_link_options(leaf_player PRIVATE "-Wl,-z,max-page-size=16384")
    target_link_options(SDL2 PRIVATE "-Wl,-z,max-page-size=16384")
elseif(IOS)
    add_executable(leaf_player MACOSX_BUNDLE "${LEAF_MOBILE_DIR}/player.cpp" "${LEAF_MOBILE_DIR}/documents.mm")
    set_target_properties(leaf_player PROPERTIES OUTPUT_NAME Leaf MACOSX_BUNDLE_INFO_PLIST "${LEAF_MOBILE_DIR}/Info.plist")
    target_link_libraries(leaf_player PRIVATE SDL2main wa2_trial SDL2-static "-framework Foundation")
else()
    message(FATAL_ERROR "Choose an Android or iOS toolchain for the mobile app")
endif()
target_include_directories(leaf_player PRIVATE "${SHINKI}/Source/FamilyApi/shinki-emu-abi/include")
