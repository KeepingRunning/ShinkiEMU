diff --git a/platform/native_desktop.cpp b/platform/native_desktop.cpp
index 0860eef..5432bde 100644
--- a/platform/native_desktop.cpp
+++ b/platform/native_desktop.cpp
@@ -27,7 +27,27 @@ resource::BankOpener native_desktop_banks(const std::filesystem::path& directory
     return [directory=directory.lexically_normal()](std::string_view name)->std::shared_ptr<resource::Source>{
         if(name.empty() || name.size()>240 || name.front()=='/' || name.find("..")!=std::string_view::npos || !name.ends_with(".pak") ||
             std::any_of(name.begin(),name.end(),[](unsigned char c){return !((c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9') || c=='_' || c=='-' || c=='.' || c=='/');}))throw resource::Error("Invalid native resource bank name");
-        try{return open_resource_file(directory/native_utf8_path(name));}catch(const resource::NotFound&){return {};}
+        const auto relative = native_utf8_path(name);
+        try { return open_resource_file(directory / relative); }
+        catch (const resource::NotFound&) {}
+        // Windows media may contain mixed-case directories and archive names.
+        auto resolved = directory;
+        for (const auto& component : relative) {
+            if (std::filesystem::exists(resolved / component)) { resolved /= component; continue; }
+            if (!std::filesystem::is_directory(resolved)) return {};
+            const auto wanted = component.string();
+            std::optional<std::filesystem::path> match;
+            for (const auto& entry : std::filesystem::directory_iterator(resolved)) {
+                const auto filename = entry.path().filename().u8string();
+                if (resource::compare_names(std::string(filename.begin(), filename.end()), wanted) != 0) continue;
+                if (match) throw resource::Error("Ambiguous resource bank path: " + std::string(name));
+                match = entry.path();
+            }
+            if (!match) return {};
+            resolved = std::move(*match);
+        }
+        try { return open_resource_file(resolved); }
+        catch (const resource::NotFound&) { return {}; }
     };
 }
