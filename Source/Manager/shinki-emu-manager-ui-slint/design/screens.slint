// ---- Patch ----

export component PatchSelectGame inherits ManagerWindow {
    init => {
        Mock.patch(false);
        Patch.game = self.mock-game;
        Patch.step = 1;
    }
    property <PatchGame> mock-game: { id: "g4", title: "夏空的英仙座", subtitle: "Musica · Shinki Musica", linked: true };
}

export component PatchRecipes inherits ManagerWindow {
    init => {
        Mock.patch-bound(true);
        Patch.step = 2;
    }
}

// The game files were identified as another release; the controller refuses to run in either mode.
export component PatchRecipeMismatch inherits ManagerWindow {
    init => {
        Mock.patch-bound(false);
        Patch.step = 2;
        Patch.state.can-start = false;
        Patch.state.error = "游戏文件与补丁适用的发行版本不匹配\n补丁适用 r36790；游戏目录中的 data/script.pak 大小与该版本不符。";
    }
}

export component PatchDirectory inherits ManagerWindow {
    init => {
        Mock.patch-bound(false);
        Patch.step = 3;
    }
}

// In-place overwrite selected on a game that already holds a backup from an earlier run.
export component PatchDirectoryInPlace inherits ManagerWindow {
    init => {
        Mock.patch-bound(false);
        Patch.step = 3;
        Patch.state.in-place = true;
        Patch.state.output-directory = "";
        Patch.state.has-backup = true;
    }
}

export component PatchConfirm inherits ManagerWindow {
