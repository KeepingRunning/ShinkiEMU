        Store.selected-title-id = "owned-title";
        Store.games = [Store.selected];
        Store.detail-open = true;
        Store.transfer = { state: "complete", title-id: "owned-title", name: "PC ダウンロード版", progress: 1, bytes: "1.2 GB / 1.2 GB", notice: "Downloaded archives need manual extraction or installer run", can-open-destination: true };
    }
}

