    ];

    public function configure() {
        Store.providers = [{ id: "steam", label: "Steam" }, { id: "dlsite", label: "DLsite" }, { id: "dmm", label: "DMM / FANZA GAMES" }];
        Store.provider-id = "steam";
        Store.provider-name = "Steam";
        Store.can-qr = true;
        Store.can-credentials = true;
        Store.has-branches = true;
        Store.has-depots = true;
        Store.can-verify = true;
    }
    public function signed-out(dark: bool) {
        Mock.base(dark);
        self.configure();
        App.page = "store";
        Store.login-state = "signed-out";
        Store.can-import-local = true;
    }

    public function library(dark: bool) {
        Mock.base(dark);
        self.configure();
        App.page = "store";
        Store.login-state = "signed-in";
        Store.account-name = "shinki_player";
        Store.library-state = "ready";
        Store.games = self.games;
        Store.library-root = "D:\\Games\\Store";
    }

    public function select(detail-open: bool) {
        Store.selected-title-id = "1144400";
        Store.selected = self.games[2];
        Store.depots = [
            { depot-id: "1144401", name: "千恋＊万花 Content", platform: "Windows", size: "4.0 GB", selected: true },
            { depot-id: "1144402", name: "千恋＊万花 Mac", platform: "macOS", size: "4.0 GB" },
        ];
        Store.language-depots = [
            { depot-id: "1144403", language: "简体中文", size: "120 MB", selected: true },
            { depot-id: "1144404", language: "英语", size: "96 MB" },
        ];
        Store.selected-depot-count = 2;
        Store.selected-size = "4.1 GB";
        Store.branches = [{ id: "public", label: "public（默认）" }, { id: "beta", label: "beta" }];
        Store.selected-branch = "public";
        Store.detail-open = detail-open;
    }

    public function downloading() {
        Store.transfer = {
            state: "downloading", title-id: "1144400", name: "千恋＊万花",
            bytes: "1.6 GB / 4.1 GB", files: "812 / 2 140 个文件", speed: "18.4 MB/s", eta: "剩余 2 分 18 秒",
            progress: 0.39, status: "正在下载内容仓库 1144401",
        };
    }
}

